# Copy to .env and fill in. Never commit .env.

# --- Model APIs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MAIN_MODEL=claude-sonnet-5-5
ANTHROPIC_EXTRACT_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_TIMEOUT_SECONDS=120
OPENAI_MAIN_MODEL=gpt-6.1-sol
OPENAI_EXTRACT_MODEL=gpt-6.1-terra
LLM_PROVIDERS=["anthropic","openai"]
OPENAI_JUDGE_MODEL=gpt-6.1-sol
OPENAI_EMBED_MODEL=

# --- Database (Neon Postgres + pgvector) ---
# Neon "dev" branch, direct (non-pooled) connection string, with the scheme changed to
# postgresql+psycopg:// . Keep ?sslmode=require. See docs/decisions.md ADR-007.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional: a separate Neon "test" branch for database tests (they are skipped when unset).
TEST_DATABASE_URL=

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recourse-cases

# --- Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# --- Gmail (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud exactly
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Encrypts stored refresh tokens at rest
TOKEN_ENCRYPTION_KEY=

# --- Email sandbox: when true, every outgoing email goes to SANDBOX_RECIPIENT ---
EMAIL_SANDBOX=true
SANDBOX_RECIPIENT=

# --- Reply watcher: how often the case's Gmail thread is checked ---
GMAIL_POLL_MINUTES=30

# --- Demo mode: 1 "day" = DEMO_DAY_SECONDS seconds ---
DEMO_MODE=true
DEMO_DAY_SECONDS=60
DEMO_GMAIL_POLL_SECONDS=10
FRONTEND_URL=http://localhost:3000
# Deployed (ADR-022): FRONTEND_URL and GOOGLE_REDIRECT_URI use the Vercel origin, OWNER_COOKIE_SECURE=true.
# The Vercel project itself sets NEXT_PUBLIC_API_URL=/api and BACKEND_URL=<the API's public URL>.
CORS_ORIGINS=["http://localhost:3000"]
OWNER_COOKIE_SECURE=false
OWNER_COOKIE_SAMESITE=lax
# Bring your own key (ADR-023): visitors use their own AI keys, held in memory only.
REQUIRE_USER_KEYS=false
INTERNAL_SECRET=
USER_KEY_TTL_MINUTES=360
API_INTERNAL_URL=http://127.0.0.1:8000
